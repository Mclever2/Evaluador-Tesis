# ── ECM: Evaluador de Calidad Metodológica ──────────────────────────────────
# Copia este archivo a .env (en la raíz del repo) y completa los valores.

# Clave de OpenAI (obligatoria para evaluar; los tests no la usan)
OPENAI_API_KEY=

# Modelos del panel de jueces. Por defecto gpt-4o-mini en los tres.
# RECOMENDACIÓN para el ciclo longitudinal: diversificar familias de modelos
# (p. ej. OpenAI / Anthropic / Google) para mitigar el sesgo de auto-preferencia.
JUDGE1_MODEL=gpt-4o-mini
JUDGE2_MODEL=gpt-4o-mini
JUDGE3_MODEL=gpt-4o-mini

# Determinismo del instrumento (no cambiar durante una medición)
EVAL_TEMPERATURE=0
EVAL_SEED=42

# Biblioteca metodológica opcional (RAG de apoyo)
EMBED_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=./data/chroma

# Persistencia de resultados
RESULTS_DIR=./data/results

# Trazado opcional con LangSmith (evidencias de pruebas de agentes)
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true

# ── Acceso ──────────────────────────────────────────────────────────────────
# Opción A (recomendada): Supabase Auth. Los usuarios se crean desde el panel
# de Supabase (Authentication → Users); la app solo tiene inicio de sesión.
# Con esto además se guarda el historial de chats y cada calificación.
# Ejecutar antes supabase/schema.sql en el SQL Editor del proyecto.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=

# Opción B: clave simple compartida (sin usuarios ni historial en la nube).
# Si no se configura nada, la API queda abierta (uso local).
# APP_ACCESS_KEY=
